{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turkish-garden-samail",
  "main": "worker.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SITE_DATA",
      "id": "PUT_YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]
}